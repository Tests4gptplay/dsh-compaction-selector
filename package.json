{
  "name": "dsh-compaction-selector",
  "version": "1.0.4-uiqa.20261029.2",
  "type": "module",
  "description": "压缩选择器：为 DeepSeek Harness 选择压缩模型及额外按需压缩次数，Auto 跟随当前对话模型。",
  "license": "MIT",
  "author": "Tests4gptplay",
  "homepage": "https://github.com/Tests4gptplay/dsh-compaction-selector",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/dsh-compaction-selector.git"
  },
  "bugs": {
    "url": "https://github.com/Tests4gptplay/dsh-compaction-selector/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "model-selection"
  ],
  "exports": {
    ".": "./index.js",
    "./engine": "./engine.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "engine.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack:check": "node scripts/verify-pack.mjs"
  }
}
